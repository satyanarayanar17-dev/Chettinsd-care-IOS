+
+struct AuditLogEntry: Codable, Identifiable {
+    let id: Int
+    let timestamp: String
+    let actor_id: String
+    let patient_id: String
+    let action: String
+    let new_state: String
+}
+
+struct GetAuditLogsEndpoint: APIEndpoint {
+    typealias Response = [AuditLogEntry]
+    var path: String { "/api/v1/opd/audit" }
+    var method: HTTPMethod { .get }
+    var requiresAuth: Bool { true }
+}
+
+class AuditTrailViewModel: ObservableObject {
+    @Published var logs: [AuditLogEntry] = []
+    @Published var errorMessage: String? = nil
+    @Published var isLoading = false
+    
+    @MainActor
+    func fetchLogs() async {
+        isLoading = true
+        do {
+            logs = try await APIClient().execute(endpoint: GetAuditLogsEndpoint())
+        } catch {
+            errorMessage = error.localizedDescription
+        }
+        isLoading = false
+    }
+}
+
+struct AuditTrailView: View {
+    @StateObject private var viewModel = AuditTrailViewModel()
+    
+    var body: some View {
+        NavigationView {
+            List {
+                if let error = viewModel.errorMessage {
+                    Section { Text(error).foregroundColor(.red) }
+                }
+                if viewModel.isLoading && viewModel.logs.isEmpty {
+                    ProgressView().frame(maxWidth: .infinity, alignment: .center)
+                }
+                
+                ForEach(viewModel.logs.sorted(by: { $0.timestamp > $1.timestamp })) { log in
+                    VStack(alignment: .leading, spacing: 4) {
+                        HStack {
+                            Text(log.action)
+                                .font(.headline)
+                                .foregroundColor(.primary)
+                            Spacer()
+                            Text(log.new_state)
+                                .font(.caption)
+                                .padding(.horizontal, 6)
+                                .padding(.vertical, 2)
+                                .background(Color.blue.opacity(0.1))
+                                .foregroundColor(.blue)
+                                .cornerRadius(4)
+                        }
+                        Text("Actor: \(log.actor_id) | Patient: \(log.patient_id)")
+                            .font(.subheadline)
+                            .foregroundColor(.secondary)
+                        Text(ISODate.display(log.timestamp))
+                            .font(.caption)
+                            .foregroundColor(.gray)
+                    }
+                    .padding(.vertical, 4)
+                }
+            }
+            .navigationTitle("Audit Trail")
+            .refreshable {
+                await viewModel.fetchLogs()
+            }
+            .task {
+                await viewModel.fetchLogs()
+            }
+        }
+    }
+}
